{
  "name": "@opendrawjs/editor",
  "version": "0.1.0",
  "description": "Framework-free opendraw editor: the canvas session (pointer, keyboard, rendering, text editing), the action registry and editor state. Framework adapters (@opendrawjs/nuxt, \u2026) are thin layers over it.",
  "keywords": [
    "opendraw",
    "excalidraw",
    "whiteboard",
    "diagram",
    "drawing",
    "canvas",
    "hand-drawn",
    "sketch",
    "editor",
    "framework-agnostic"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Vishnu",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAlphaOnes/opendraw",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/TheAlphaOnes/opendraw#readme",
  "bugs": {
    "url": "https://github.com/TheAlphaOnes/opendraw/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./styles/opendraw.css",
    "./fonts.css": "./styles/fonts.css"
  },
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opendrawjs/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
