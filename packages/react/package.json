{
  "name": "@opendrawjs/react",
  "version": "0.1.0",
  "description": "React adapter for opendraw: <OpenDraw>, <OpenDrawCanvas> and hooks over the framework-free @opendrawjs/editor.",
  "keywords": [
    "opendraw",
    "excalidraw",
    "whiteboard",
    "diagram",
    "drawing",
    "canvas",
    "hand-drawn",
    "sketch",
    "react"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Vishnu",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAlphaOnes/opendraw",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/TheAlphaOnes/opendraw#readme",
  "bugs": {
    "url": "https://github.com/TheAlphaOnes/opendraw/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opendrawjs/core": "workspace:*",
    "@opendrawjs/editor": "workspace:*",
    "lucide-react": "^1.65.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
