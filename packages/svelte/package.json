{
  "name": "@opendrawjs/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 adapter for opendraw: <OpenDraw>, <OpenDrawCanvas> and editor state runes over the framework-free @opendrawjs/editor.",
  "keywords": [
    "opendraw",
    "excalidraw",
    "whiteboard",
    "diagram",
    "drawing",
    "canvas",
    "hand-drawn",
    "sketch",
    "svelte",
    "svelte5"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Vishnu",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAlphaOnes/opendraw",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/TheAlphaOnes/opendraw#readme",
  "bugs": {
    "url": "https://github.com/TheAlphaOnes/opendraw/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "prepack": "pnpm run build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@lucide/svelte": "^1.65.0",
    "@opendrawjs/core": "workspace:*",
    "@opendrawjs/editor": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
