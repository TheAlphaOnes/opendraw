{
  "name": "@opendraw/nuxt",
  "version": "0.1.0",
  "description": "Excalidraw-style hand-drawn canvas for Nuxt 4 \u2014 a drop-in <OpenDraw /> editor module.",
  "type": "module",
  "license": "MIT",
  "author": "Vishnu",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAlphaOnes/opendraw",
    "directory": "packages/nuxt"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "@opendraw/core": "workspace:*",
    "@opendraw/editor": "workspace:*",
    "lucide-vue-next": "^1.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.0.0",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-tsc": "^2.1.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  }
}
