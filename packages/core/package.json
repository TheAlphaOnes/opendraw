{
  "name": "@opendrawjs/core",
  "version": "0.1.0",
  "description": "Framework-agnostic canvas engine behind opendraw \u2014 element model, scene store, history, geometry and hand-drawn rendering.",
  "keywords": [
    "opendraw",
    "excalidraw",
    "whiteboard",
    "diagram",
    "drawing",
    "canvas",
    "hand-drawn",
    "sketch",
    "roughjs",
    "engine"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Vishnu",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAlphaOnes/opendraw",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/TheAlphaOnes/opendraw#readme",
  "bugs": {
    "url": "https://github.com/TheAlphaOnes/opendraw/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
