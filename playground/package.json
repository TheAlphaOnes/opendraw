{
  "name": "opendraw-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt prepare >/dev/null && vue-tsc --noEmit -p .nuxt/tsconfig.json && vue-tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "generate": "nuxt generate",
    "assets": "node scripts/capture-assets.mjs"
  },
  "dependencies": {
    "@opendrawjs/core": "workspace:*",
    "@opendrawjs/editor": "workspace:*",
    "@opendrawjs/nuxt": "workspace:*",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "lucide-vue-next": "^1.0.0",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6",
    "vue-tsc": "^2.2.12"
  }
}
