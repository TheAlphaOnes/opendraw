{
  "name": "vuedraw-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter @vuedraw/core build && pnpm --filter vuedraw build",
    "dev:prepare": "pnpm --filter @vuedraw/core build && pnpm --filter vuedraw dev:prepare",
    "dev": "pnpm dev:prepare && pnpm --filter playground dev",
    "build:playground": "pnpm --filter playground build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
